# WanderDesa — root env pointer
#
# Authoritative application environment lives in:
#   backend/.env
#   backend/.env.example
#
# Copy backend/.env.example → backend/.env and run:
#   php artisan key:generate
# from the backend/ directory.
#
# Do not put production secrets in this file or in git.
# Kiosk API base URL and device credentials belong in Flutter flavors / dart-define, not in source.
