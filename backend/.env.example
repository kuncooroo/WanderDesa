APP_NAME=WanderDesa
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Application timezone is UTC in config/app.php (docs/06 DP-07).

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Authoritative store is MySQL 8.4.x (docs/06-DATABASE.md). Feature tests use
# SQLite in-memory via phpunit.xml.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wanderdesa
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production: set SESSION_SECURE_COOKIE=true behind HTTPS (SRS-SES-01 / SEC cookies).
# Unset in production defaults to true when APP_ENV=production.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Production: also run `php artisan schedule:run` every minute (cron) and a
# queue worker. See backend/README.md scheduler section (TASK-026).
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Optional email fan-out for ops alerts (kiosk offline, webhook processing failures).
# Database notifications always run. Leave false unless SMTP is configured.
OPS_NOTIFICATION_MAIL=false

# Daily MySQL dump via `php artisan ops:backup-mysql` (scheduler 02:15 app TZ).
# BACKUP_MYSQL_ENABLED=true
# BACKUP_PATH=
# BACKUP_RETENTION_DAYS=14
# BACKUP_MYSQLDUMP_BIN=mysqldump

# Optional least-privilege pilot staff (DatabaseSeeder → PilotStaffSeeder).
# Leave blank to skip. Never use these vars for Super Admin.
PILOT_ADMIN_NAME=pilotadmin
PILOT_ADMIN_EMAIL=pilotadmin@gmail.com
PILOT_ADMIN_PASSWORD=pilotadmin123
PILOT_MANAGER_NAME=pilotmanager
PILOT_MANAGER_EMAIL=pilotmanager@gmail.com
PILOT_MANAGER_PASSWORD=pilotmanager123
PILOT_FINANCE_NAME=pilotfinance
PILOT_FINANCE_EMAIL=pilotfinance@gmail.com
PILOT_FINANCE_PASSWORD=pilotfinance123
PILOT_TICKET_OFFICER_NAME=pilotticketofficer
PILOT_TICKET_OFFICER_EMAIL=pilotticketofficer@gmail.com
PILOT_TICKET_OFFICER_PASSWORD=pilotticketofficer123
PILOT_GATE_OFFICER_NAME=pilotgateofficer
PILOT_GATE_OFFICER_EMAIL=pilotgateofficer@gmail.com
PILOT_GATE_OFFICER_PASSWORD=pilotgateofficer123
PILOT_OPERATOR_NAME=pilotoperator
PILOT_OPERATOR_EMAIL=pilotoperator@gmail.com
PILOT_OPERATOR_PASSWORD=pilotoperator123
PILOT_AUDITOR_NAME=pilotauditor
PILOT_AUDITOR_EMAIL=pilotauditor@gmail.com
PILOT_AUDITOR_PASSWORD=pilotauditor123

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Digital payment adapter until a vendor is chosen (TASK-011). `sandbox` or `null`.
# Never mark PAID from a client. Do not put provider secrets here.
PAYMENT_GATEWAY=sandbox
# HMAC-SHA256 secret for POST /api/v1/webhooks/payments/sandbox. Fail closed if empty.
# PAYMENT_WEBHOOK_SECRET=
# PAYMENT_WEBHOOK_SIGNATURE_HEADER=X-WanderDesa-Webhook-Signature

# Opaque ticket QR HMAC (TASK-012). Falls back to APP_KEY when empty.
# TICKET_QR_SECRET=
# TICKET_QR_KID=v1

# Optional first Super Admin (SuperAdminSeeder). Leave blank to skip.
# Never commit real passwords. SUPER_ADMIN_PASSWORD is required with name+email.
SUPER_ADMIN_NAME=superadmin
SUPER_ADMIN_EMAIL=superadmin@gmail.com
SUPER_ADMIN_PASSWORD=superadmin123

# --- Secret inventory (never commit real values; see docs/12-SECURITY-CHECKLIST.md) ---
# APP_KEY                     Laravel cipher key
# APP_DEBUG                   Must be false in production
# SESSION_SECURE_COOKIE       Must be true behind HTTPS in production
# DB_PASSWORD / REDIS_PASSWORD
# PAYMENT_WEBHOOK_SECRET      Required for sandbox/provider webhooks (fail-closed if empty)
# TICKET_QR_SECRET            Opaque QR HMAC (falls back to APP_KEY)
# SUPER_ADMIN_PASSWORD        Seeder only
# PILOT_*_PASSWORD            Optional least-privilege pilot staff (not Super Admin)
# MAIL_* / AWS_*              Optional integrations
# OPS_NOTIFICATION_MAIL       Ops email fan-out (false unless SMTP is configured)
# BACKUP_PATH                 MySQL dump directory on the VPS (not in git)

